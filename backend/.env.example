NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
AUTH_EMAIL_REDIRECT_URL=http://localhost:3000/login
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_COVERS=exam-covers
STORAGE_BUCKET_EXAM_ASSETS=exam-assets
STORAGE_BUCKET_SAMPLE_ASSETS=sample-assets
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_JWT_SECRET=
LOG_QUERIES=0
COOKIE_SAME_SITE=lax

AUTH_GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Chỉ dùng cho tests/auth-jwt.test.mjs và tests/benchmark-runner.mjs
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_ADMIN_AUTH_ID=
TEST_ADMIN_USER_ID=
# Speech-to-Text transcript generation (Groq Whisper)
GROQ_API_KEY=

# Optional vocabulary media providers (backend only; never use VITE_ keys)
MW_LEARNERS_KEY=
MW_DICTIONARY_KEY=
# Set only if the Dictionary key is for the Collegiate product:
# MW_DICTIONARY_PRODUCT=collegiate
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
