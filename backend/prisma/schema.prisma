generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Thêm model theo thiết kế cơ sở dữ liệu trước khi generate/migrate.

// Mapping đọc hồ sơ có sẵn. Không dùng schema rút gọn này để migrate database.
model users {
  id           String  @id @db.Uuid
  auth_user_id String? @unique @db.Uuid
  full_name    String
  display_name String?
  email        String?
  avatar_url   String?
  role         String
  status       String
}

model exam_set_categories {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String?     @unique
  name       String
  order_no   Int         @default(100)
  created_by String?     @db.Uuid
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  exam_sets  exam_sets[]
}

model exam_sets {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String?
  cover_url    String?
  category_id  String              @db.Uuid
  status       String              @default("DRAFT")
  published_at DateTime?           @db.Timestamptz(6)
  created_by   String?             @db.Uuid
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @db.Timestamptz(6)
  category     exam_set_categories @relation(fields: [category_id], references: [id])
  exams        exams[]
}

model exams {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_set_id String        @db.Uuid
  title       String
  order_no    Int
  description String?
  created_by  String?       @db.Uuid
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  exam_set    exam_sets     @relation(fields: [exam_set_id], references: [id])
  skills      exam_skills[]
  attempts    attempts[]
  imports     import_batches[]

  @@unique([exam_set_id, order_no])
}

model exam_skills {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id          String          @db.Uuid
  skill            String
  form             String?
  version_number   Int
  status           String          @default("DRAFT")
  duration_minutes Int
  band_scale_id    String?         @db.Uuid
  grading_rule_id  String?         @db.Uuid
  created_by       String?         @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  published_at     DateTime?       @db.Timestamptz(6)
  exam             exams           @relation(fields: [exam_id], references: [id])
  sections         exam_sections[]
}

model exam_sections {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_skill_id String            @db.Uuid
  title         String
  section_type  String
  config        Json              @default("{}")
  instruction   String?
  content       Json              @default("{}")
  transcript    Json              @default("[]")
  audio_path    String?
  image_path    String?
  order_no      Int
  exam_skill    exam_skills       @relation(fields: [exam_skill_id], references: [id])
  groups        question_groups[]
}

model question_groups {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section_id    String        @db.Uuid
  title         String?
  question_from Int?
  question_to   Int?
  config        Json          @default("{}")
  question_type String
  instruction   String?
  content       Json          @default("{}")
  audio_path    String?
  image_path    String?
  order_no      Int
  section       exam_sections @relation(fields: [section_id], references: [id])
  questions     questions[]
}

model questions {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_group_id String             @db.Uuid
  content           Json
  question_type     String
  number_from       Int?
  number_to         Int?
  answer_count      Int                @default(1)
  max_score         Decimal            @default(1)
  explanation       Json?
  order_no          Int
  group             question_groups    @relation(fields: [question_group_id], references: [id])
  options           question_options[]
  answer            question_answers?
}

model question_options {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id String    @db.Uuid
  label       String
  content     String
  order_no    Int
  question    questions @relation(fields: [question_id], references: [id])
}

model question_answers {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id      String    @unique @db.Uuid
  accepted_answers Json
  matching_rule    Json
  evidence         Json      @default("{}")
  question         questions @relation(fields: [question_id], references: [id])
}

model attempts {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  exam_id      String    @db.Uuid
  attempt_type String
  status       String    @default("IN_PROGRESS")
  started_at   DateTime  @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  exam         exams     @relation(fields: [exam_id], references: [id])
}

model band_scales {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  skill   String
  form    String?
  version Int
}

model grading_rules {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  skill             String
  assessment_scope  String
  version           Int
  aggregation_rules Json?
  rounding_rules    Json?
  rubric_criteria   rubric_criteria[]
}

model rubric_criteria {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grading_rule_id String        @db.Uuid
  name            String
  description     String?
  weight          Decimal       @db.Decimal
  min_score       Decimal       @db.Decimal
  max_score       Decimal       @db.Decimal
  score_step      Decimal       @db.Decimal
  order_no        Int
  grading_rule    grading_rules @relation(fields: [grading_rule_id], references: [id])
}

model import_batches {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_key String          @unique @db.Uuid
  import_type String
  exam_id     String?         @db.Uuid
  skill       String?
  form        String?
  file_name   String
  status      String          @default("PENDING")
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  exam        exams?          @relation(fields: [exam_id], references: [id])
  assets      import_assets[]
  errors      import_errors[]
}

model import_assets {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id     String         @db.Uuid
  file_name    String
  storage_path String
  batch        import_batches @relation(fields: [batch_id], references: [id])
}

model import_errors {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id String         @db.Uuid
  message  String
  severity String
  batch    import_batches @relation(fields: [batch_id], references: [id])
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String?  @db.Uuid
  actor_type  String
  action      String
  entity_type String
  entity_id   String?  @db.Uuid
  change_data Json?
  reason      String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}
